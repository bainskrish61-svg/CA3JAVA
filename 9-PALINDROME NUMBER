class Solution {
    public boolean isPalindrome(int x) {
        int n,s=0,c,r;
        c=x;
        while(x>0)
        {
            r=x%10;
            s=(s*10)+r;
            x=x/10;
        }

        if(c==s){
            return true;
        }
        else{
            return false;
        }
        
    }
}
